{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!dist",
      "!.wrangler",
      "!.vercel",
      "!.netlify",
      "!.output",
      "!build",
      "!deprecated",
      "!pnpm-lock.yaml",
      "!**/routeTree.gen.ts",
      "!.tanstack",
      "!**/*.css",
      "!public",
      "!registry.json",
      "!playwright-report",
      "!test-results"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noArrayIndexKey": "error",
        "useIterableCallbackReturn": "warn"
      },
      "a11y": {
        "noStaticElementInteractions": "warn",
        "noNoninteractiveTabindex": "warn",
        "noInteractiveElementToNoninteractiveRole": "warn",
        "useSemanticElements": "warn",
        "useButtonType": "warn",
        "useAriaPropsSupportedByRole": "warn"
      },
      "nursery": {
        "useTailwindSortedClasses": {
          "level": "warn",
          "fix": "safe"
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/code-block.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/heatmap/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off",
            "noStaticElementInteractions": "off"
          }
        }
      }
    }
  ]
}

{
  "name": "shadcn-heatmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "description": "Beautiful, accessible heatmap components for React. Built with shadcn/ui conventions.",
  "author": "ChingRu <hello@chingru.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rutopio/shadcn-heatmap.git"
  },
  "homepage": "https://heatmap.chingru.com",
  "bugs": {
    "url": "https://github.com/rutopio/shadcn-heatmap/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:registry && tsc -b && vite build",
    "build:registry": "tsx scripts/build-registry.ts",
    "format": "biome format --write . && node scripts/format-snippets.mjs",
    "preview": "vite preview",
    "lint": "biome lint .",
    "check-types": "tsc -b --noEmit && tsc -p functions/tsconfig.json",
    "check": "biome check --write . && pnpm lint && pnpm check-types"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@fontsource-variable/albert-sans": "5.2.8",
    "@fontsource-variable/host-grotesk": "5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "@tanstack/react-router": "1.170.16",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@cloudflare/workers-types": "^4.20260620.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@shikijs/core": "4.2.0",
    "@shikijs/engine-oniguruma": "4.2.0",
    "@shikijs/langs": "4.2.0",
    "@shikijs/themes": "4.2.0",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/router-plugin": "1.168.18",
    "@types/node": "26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "prettier": "3.8.4",
    "prettier-plugin-tailwindcss": "0.8.0",
    "shiki": "4.2.0",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
